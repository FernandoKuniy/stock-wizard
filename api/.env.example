FINNHUB_API_KEY=
DATABASE_URL=
# Your Supabase project URL, e.g. https://abcdefgh.supabase.co. Not a secret: the API
# uses it to find the project's public JWKS and verify users' access tokens locally.
# The project must have JWT signing keys enabled (asymmetric ES256/RS256, the default
# for new projects). The legacy shared HS256 secret is not accepted.
SUPABASE_URL=
# Optional. Twelve Data key for the historical price charts. Finnhub's free tier
# no longer serves candles; the app still runs without this, only charts need it.
TWELVE_DATA_API_KEY=
# Optional. OpenAI key for the AI tutor. The app still runs without it; the tutor
# endpoint just reports that it isn't set up. The model is swappable via TUTOR_MODEL.
OPENAI_API_KEY=
# Optional. Overrides the tutor's model. Defaults to the cheapest current model.
# TUTOR_MODEL=gpt-5.4-nano
# Optional, but set it in any deployed/public environment. A shared invite code that
# gates account creation: a signed-in user gets no account and no access to the app
# until they redeem this code once. Leave it unset locally to keep signup frictionless.
# Use a long, random value. This is the one thing standing between a public URL and every
# passer-by (and bot) spending your OpenAI and market-data quota.
# SIGNUP_CODE=
# Optional. Frontend origin allowed through CORS. Defaults to http://localhost:3000
# when unset, so leave it out unless you need to override it.
# FRONTEND_ORIGIN=
