FINNHUB_API_KEY=
DATABASE_URL=
# Your Supabase project URL, e.g. https://abcdefgh.supabase.co. Not a secret: the API
# uses it to find the project's public JWKS and verify users' access tokens locally.
# The project must have JWT signing keys enabled (asymmetric ES256/RS256, the default
# for new projects). The legacy shared HS256 secret is not accepted.
SUPABASE_URL=
# Optional. Twelve Data key for the historical price charts. Finnhub's free tier
# no longer serves candles; the app still runs without this, only charts need it.
TWELVE_DATA_API_KEY=
# Optional. OpenAI key for the AI tutor. The app still runs without it; the tutor
# endpoint just reports that it isn't set up. The model is swappable via TUTOR_MODEL.
OPENAI_API_KEY=
# Optional. Overrides the tutor's model. Defaults to the cheapest current model.
# TUTOR_MODEL=gpt-5.4-nano
# Optional, but set it in any deployed/public environment. A shared invite code that
# gates account creation: a signed-in user gets no account and no access to the app
# until they redeem this code once. Leave it unset locally to keep signup frictionless.
# Use a long, random value. This is the one thing standing between a public URL and every
# passer-by (and bot) spending your OpenAI and market-data quota.
# SIGNUP_CODE=
# Optional, and safe to publish: this one goes in the README. It opens a real account with
# one difference, the AI tutor is capped at DEMO_TUTOR_MESSAGE_LIMIT questions for the life
# of the account, after which the app points the visitor at the author's site to ask for the
# code above. Only does anything when SIGNUP_CODE is also set, and it must not equal it (the
# app refuses to start if it does). The tutor is the only route that costs money per call;
# trading, charts, and everything else stay unrestricted for a demo account.
# DEMO_SIGNUP_CODE=
# Optional, defaults to 1. How many tutor questions a demo account gets, ever. Not a rate:
# a lifetime allowance counted in Postgres, because the in-process limiter resets on every
# restart. Set it to 0 to switch the demo tutor off without rotating the published code.
# DEMO_TUTOR_MESSAGE_LIMIT=1
# Optional. Give every new account the six-month sample portfolio on first sign-in, so a
# visitor lands on a dashboard that teaches instead of an empty one. Off by default (local
# dev and tests open empty accounts); set it true for the hosted demo. Needs the Twelve
# Data key, and it degrades to an empty account if the market data can't be fetched.
# SEED_NEW_ACCOUNTS=true
# Optional. A light per-account cap on tutor calls per minute (defaults to 15), so a leaked
# invite code can't loop the tutor and run up the OpenAI bill.
# TUTOR_RATE_LIMIT_PER_MINUTE=15
# Optional locally (defaults to http://localhost:3000), required when deployed: the frontend
# origin(s) allowed through CORS, since the browser calls this API cross-origin. Set it to the
# deployed frontend URL, e.g. https://stock-wizard.vercel.app. Comma-separate to allow more than
# one (a preview URL or a custom domain). No trailing slash.
# FRONTEND_ORIGIN=
